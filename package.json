{
    "name": "irmats",
    "version": "1.0.0",
    "description": "TypeScript port of the Yivi signature/disclosure verification path (gabi + irmago)",
    "type": "module",
    "license": "ISC",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    	"LICENSES.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "prepack": "tsup",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage",
        "bench": "vitest bench",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
    },
    "dependencies": {
        "asn1js": "^3.0.6",
        "fast-xml-parser": "^5.3.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.9.1",
        "@vitest/coverage-v8": "^4.1.3",
        "@vitest/ui": "^4.1.3",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-comment-length": "^2.3.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.1.1",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2",
        "vitest": "^4.1.3"
    }
}
